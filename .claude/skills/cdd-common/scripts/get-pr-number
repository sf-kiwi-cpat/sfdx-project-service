#!/usr/bin/env bash
# Gets the PR number associated with a branch.
# Usage: get-pr-number [branch]
#   branch defaults to the current git branch.
set -euo pipefail

branch="${1:-$(git branch --show-current)}"
number=$(gh pr list --head "$branch" --json number -q '.[0].number')

if [ -z "$number" ]; then
  echo "error: no open PR found for branch '$branch'" >&2
  exit 1
fi

echo "$number"
