{
  "name": "@salesforce/sfdx-project-service",
  "version": "0.1.0",
  "description": "REST API wrapping an SFDX project for remote IDE-like operations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sfdx-project-service": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates/dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run build:templates",
    "build:templates": "node scripts/zip-templates.js",
    "pretest": "npm run build:templates",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "npm run build:templates && tsx watch src/index.ts",
    "test": "vitest run",
    "test:spec": "vitest run spec/",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:quality": "vitest run tests/",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/sse": "^0.4.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@salesforce/core": "^8.26.0",
    "@salesforce/source-deploy-retrieve": "^12.31.21",
    "@salesforce/templates": "^66.6.2",
    "@sinclair/typebox": "^0.34.0",
    "adm-zip": "^0.5.16",
    "chokidar": "^5.0.0",
    "fastify": "^5.0.0",
    "pino": "^9.4.0",
    "vite": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-notice": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "volta": {
    "node": "22.22.1"
  }
}
