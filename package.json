{
  "name": "sf-project-service",
  "version": "1.0.0",
  "description": "REST API wrapping an SFDX project for remote IDE-like operations",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:spec": "vitest run spec/",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@salesforce/core": "^8.26.0",
    "@salesforce/source-deploy-retrieve": "^12.31.21",
    "@sinclair/typebox": "^0.34.0",
    "adm-zip": "^0.5.16",
    "fastify": "^5.0.0",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
