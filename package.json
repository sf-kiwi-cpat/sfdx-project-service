{
  "name": "@salesforce/sfdx-project-service",
  "version": "0.1.0",
  "description": "REST API wrapping an SFDX project for remote IDE-like operations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sfdx-project-service": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates/dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run build:templates && npm run build:assets",
    "build:templates": "node scripts/zip-templates.js",
    "build:assets": "node scripts/copy-visualizer-assets.js",
    "pretest": "npm run build:templates",
    "pretest:integration": "npm run build:templates",
    "pretest:spec": "npm run build:templates",
    "pretest:coverage": "npm run build:templates",
    "pretest:quality": "npm run build:templates",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "npm run build:templates && tsx watch src/index.ts",
    "test": "vitest run",
    "test:spec": "vitest run spec/",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:deploy:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "knip",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:quality": "vitest run --coverage && node scripts/check-per-file-coverage.js",
    "test:coverage": "vitest run --coverage && node scripts/check-per-file-coverage.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/sse": "^0.5.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@salesforce/agents": "^1.6.11",
    "@salesforce/core": "^8.26.0",
    "@salesforce/metadata-core-sdk": "^1.1.0",
    "@salesforce/metadata-plugins": "^1.1.0",
    "@salesforce/metadata-visualizer-core": "^1.1.0",
    "@salesforce/source-deploy-retrieve": "^12.35.0",
    "@salesforce/templates": "^66.6.2",
    "@salesforce/vite-plugin-ui-bundle": "^3.1.0",
    "@sinclair/typebox": "^0.34.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chokidar": "^5.0.0",
    "extract-zip": "^2.0.1",
    "fastify": "^5.9.0",
    "glob": "^13.0.6",
    "pino": "^9.4.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@stryker-mutator/core": "~9.6.1",
    "@stryker-mutator/typescript-checker": "~9.6.1",
    "@stryker-mutator/vitest-runner": "~9.6.1",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-notice": "^1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.13.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "volta": {
    "node": "22.22.1"
  }
}
